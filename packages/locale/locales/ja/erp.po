msgstr "在物理上存放库存的货架和箱子"

#: packages/onboarding/src/content/setup.ts:194
msgid "The shop supplies and consumables you keep on hand"
msgstr "手元に保管する店舗用品と消耗品"

#: packages/glossary/src/terms.ts:1171
