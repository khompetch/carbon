msgstr "このワークフローを使用するすべてのイシューが閉じられる前に必要な署名。"

#: apps/erp/app/modules/items/ui/Item/RevisionForm.tsx:110
msgid "The size of the part"
msgstr "部品のサイズ"

#: packages/onboarding/src/content/setup.ts:98
msgid "The skills and abilities you track for your people"
msgstr "あなたの人々のために追跡するスキルと能力"

#: packages/glossary/src/terms.ts:960
