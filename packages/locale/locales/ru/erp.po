#: apps/erp/app/routes/x+/account+/theme.tsx:12
msgid "Theme"
msgstr "Тема"

#: apps/erp/app/components/AvatarMenu.tsx:147
msgid "Theme Color"
msgstr "Цвет темы"

#: apps/erp/app/modules/purchasing/ui/SupplierQuote/SupplierQuoteCompareDrawer.tsx:257
msgid "There are no active supplier quotes to compare for this RFQ."
msgstr "Нет активных предложений поставщиков для сравнения по этому РФП."

