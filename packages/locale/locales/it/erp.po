#: apps/erp/app/modules/accounting/ui/AccountDefaults/AccountDefaultsForm.tsx:144
msgid "Account for production orders not yet completed"
msgstr "Contabilizzate gli ordini di produzione non ancora completati."

#: apps/erp/app/modules/accounting/ui/AccountDefaults/AccountDefaultsForm.tsx:471
msgid "Account for small rounding differences in transactions"
msgstr "Contabilizzate le piccole differenze di arrotondamento nelle transazioni."

#: apps/erp/app/modules/accounting/ui/AccountDefaults/AccountDefaultsForm.tsx:175
msgid "Account for the cost of fixed assets when disposed"
