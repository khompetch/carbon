msgstr "O mnie"

#: apps/erp/app/modules/quality/ui/InboundInspections/InboundInspectionLotView.tsx:357
#: apps/erp/app/modules/quality/ui/InboundInspections/InboundInspectionLotView.tsx:387
msgid "Accept Lot"
