###############################################################################
# Carbon on Dokploy — environment variables for docker-compose.yml in this
# folder. Paste these into Dokploy's "Environment" panel for the application
# (or the compose project's .env, depending on how Dokploy is configured) and
# fill in every value. This file is a template only — do not commit filled-in
# secrets.
#
# This stack bundles its own Supabase, so most of the values below are
# secrets YOU generate locally (openssl / the bundled scripts), not values
# copied from somewhere else.
###############################################################################

# ── Domains (must match what you configure in Dokploy's Domains tab) ─────────
# SUPABASE_URL must be routed to the `gateway` service (port 8000) — it's the
# public gateway for auth/rest/storage/realtime/functions.
DOMAIN=example.com
ERP_URL=https://erp.example.com
MES_URL=https://mes.example.com
SUPABASE_URL=https://supabase.example.com

# ── Generate these yourself ───────────────────────────────────────────────────
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=
# Run `bash scripts/gen-supabase-keys.sh` and paste its three output lines
# here (SUPABASE_JWT_SECRET / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY).
# They are a matched set — generate them together, don't mix values from
# different runs.
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# openssl rand -hex 32 / openssl rand -hex 16
# Plain hex: self-hosted Inngest rejects the `signkey-` prefix.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
# Supavisor (connection pooler) — openssl rand -hex 32 / openssl rand -hex 16
SUPAVISOR_SECRET_KEY_BASE=
SUPAVISOR_VAULT_ENC_KEY=

# ── First admin (optional) ────────────────────────────────────────────────────
# When set, the `migrate` job creates this account (no password, no company)
# on its next run. Log in at ERP_URL/login with a magic link and set up the
# first company in onboarding. Safe to leave set: it is idempotent.
ADMIN_EMAIL=

# ── Outbound email (GoTrue auth + app email) ─────────────────────────────────
# Both GoTrue (invites, magic links) and the apps send over this SMTP account.
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASSWORD=
GOTRUE_SMTP_ADMIN_EMAIL=admin@example.com
GOTRUE_SMTP_SENDER_NAME=Carbon
GOTRUE_DISABLE_SIGNUP=true
# From-address for app email (envelope sender).
SMTP_FROM="Carbon <no-reply@example.com>"

# Sign-in methods shown on the login screen (comma-separated):
# email,google,azure,passkey,password. Adding "password" lets users sign in
# with email+password after setting one at /x/account/password in the ERP.
AUTH_PROVIDERS=email,google,azure

# ── OAuth (optional; leave disabled unless configured) ───────────────────────
GOOGLE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_REDIRECT_URI=
AZURE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_REDIRECT_URI=

# ── Enterprise SAML SSO (optional) ────────────────────────────────────────────
# Generate the key with:
#   openssl genpkey -algorithm RSA -out /tmp/pk.pem -quiet && \
#   openssl rsa -in /tmp/pk.pem -outform DER -traditional -out /tmp/pk.der && \
#   base64 -w 0 /tmp/pk.der
# MUST be base64-encoded PKCS#1 DER (the -traditional flag), min 2048-bit.
SAML_ENABLED=false
SAML_PRIVATE_KEY=

# ── Postgres tuning (size to your VPS; see postgres/02-performance.sh) ────────
# Rules of thumb: shared_buffers ~25% RAM, effective_cache_size ~50-75% RAM,
# work_mem * max_connections under ~25% RAM. Defaults suit a ~4 GB host.
# Applied on first init of an empty pgdata volume only.
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB

# ── Supavisor (connection pooler) ────────────────────────────────────────────
# Postgres connections it keeps for the apps, and the client connections it
# accepts. Keep the pool, plus the other services' connections, under
# PG_MAX_CONNECTIONS.
SUPAVISOR_POOL_SIZE=20
SUPAVISOR_MAX_CLIENT_CONN=100

# ── Realtime (internal keys; override for extra hygiene) ──────────────────────
REALTIME_SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=

# ── Edge functions ───────────────────────────────────────────────────────────
# Verify the JWT signature of every edge-function call. Keep it on: the
# gateway forwards /functions/v1/ without checking tokens.
EDGE_VERIFY_JWT=true

# ── Supabase Studio (optional) ────────────────────────────────────────────────
# Studio and postgres-meta (which runs SQL as supabase_admin, with no auth of
# its own) are off by default. Uncomment to run both, internal-only; see
# README "Supabase Studio" for how to reach it.
# COMPOSE_PROFILES=studio

# ── App config (optional) ─────────────────────────────────────────────────────
CARBON_EDITION=community
# Optional: app email goes over SMTP above. Leave empty unless you use Resend
# for marketing contacts.
RESEND_API_KEY=
# true answers every request except /health with a 503 maintenance screen.
# Apply with a Redeploy; the apps read it at start.
# MAINTENANCE_MODE=true
# Optional JSON document ({ latestVersion?, announcement? }) shown as a bar in the app.
# SYSTEM_STATUS_URL=https://example.com/status.json

# ── Build resources ───────────────────────────────────────────────────────────
# Build erp and mes one at a time instead of in parallel. Building both at
# once while the stack is running exhausts memory on small VPSes (the build
# hangs around "rendering chunks"). See README "Troubleshooting".
COMPOSE_PARALLEL_LIMIT=1

# Tag for the erp image. The default is fine for a single Carbon stack; set it
# if you run two on one host (they would otherwise claim the same local tag)
# or to pull a prebuilt image from a registry instead.
# CARBON_IMAGE_ERP=carbon-erp:local

# Tag for the bootstrap image the one-shot `migrate` job runs. It is built
# from the same revision as erp, but from the Dockerfile's `bootstrap` stage —
# the served `runner` stage strips the supabase CLI for its CVE posture, so
# `supabase migration up` can only run from `bootstrap`. Same rule as above:
# set it if two Carbon stacks share a host. (Replaces CARBON_IMAGE_OPS.)
# CARBON_IMAGE_BOOTSTRAP=carbon-bootstrap:local
