###############################################################################
# Carbon on Dokploy — environment variables for docker-compose.yml in this
# folder. Paste these into Dokploy's "Environment" panel for the application
# (or the compose project's .env, depending on how Dokploy is configured) and
# fill in every value. This file is a template only — do not commit filled-in
# secrets.
###############################################################################

# ── Supabase (already running in Dokploy — copy these from that deployment) ──
# Public API URL / gateway (e.g. Kong) of your existing Supabase instance.
SUPABASE_URL=https://supabase.example.com
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Must match the JWT secret your Supabase's GoTrue/PostgREST were configured
# with — the anon/service-role keys above are JWTs signed with this secret.
SUPABASE_JWT_SECRET=
# Direct Postgres connection string for the existing Supabase database.
SUPABASE_DB_URL=postgresql://postgres:<password>@<host>:5432/postgres

# ── Generate these yourself ───────────────────────────────────────────────────
# openssl rand -hex 32
SESSION_SECRET=
# Only needed if you keep the bundled `inngest` service in docker-compose.yml.
# If you use Inngest Cloud instead, get these from your Inngest dashboard.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# ── Domains (must match what you configure in Dokploy's Domains tab) ─────────
DOMAIN=example.com
ERP_URL=https://erp.example.com
MES_URL=https://mes.example.com

# ── Redis ──────────────────────────────────────────────────────────────────────
# Default points at the `redis` service in docker-compose.yml. Point at an
# existing instance instead (and delete that service) if Dokploy already runs
# one you want to reuse.
REDIS_URL=redis://redis:6379

# ── App config (optional) ─────────────────────────────────────────────────────
CARBON_EDITION=community
AUTH_PROVIDERS=email,google,azure
RESEND_API_KEY=
RESEND_DOMAIN=example.com
