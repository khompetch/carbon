# Carbon print agent configuration. Copy to .env and fill in.

# Required — Carbon sends this in the X-API-Key header. Generate with:
#   openssl rand -hex 24
API_KEY=

# One variable per printer: PRINTER_<NAME>=tcp://<host>[:port]
# <NAME> (lowercased) becomes the URL path: POST /print/<name>
# Port defaults to 9100 (the standard raw-print port on Zebra thermal
# printers and most network laser printers).
PRINTER_ZEBRA1=tcp://192.168.1.50:9100
# PRINTER_LASER1=tcp://192.168.1.60:9100

# Listen port (default 8631).
# PORT=8631

# Only needed with `docker compose --profile tunnel up -d` — the token for a
# Cloudflare Tunnel that maps a public hostname to http://print-agent:8631.
TUNNEL_TOKEN=
